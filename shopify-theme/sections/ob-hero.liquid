<div data-ob-island="hero" data-ob-client="true"><script type="application/json" data-ob-props>{"interval":{{ section.settings.interval | times: 1000 }},"customSlides":[{% assign emitted = false %}{% for block in section.blocks %}{% if block.settings.image %}{% if emitted %},{% endif %}{"src":{{ block.settings.image | image_url: width: 2400 | json }},"alt":{{ block.settings.alt | json }},"eyebrow":{{ block.settings.eyebrow | json }},"title":{{ block.settings.title | json }},"buttonText":{{ block.settings.button | json }},"href":{{ block.settings.link | default: routes.all_products_collection_url | json }}}{% assign emitted = true %}{% endif %}{% endfor %}]}</script></div>
{% schema %}
{"name":"Blinds hero","settings":[{"type":"paragraph","content":"Without custom image slides, the original seasonal slides are used. Add an image to each custom slide to display it."},{"type":"range","id":"interval","label":"Slide interval","min":3,"max":12,"step":1,"unit":"s","default":6}],"max_blocks":8,"blocks":[{"type":"slide","name":"Slide","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"alt","label":"Image description"},{"type":"text","id":"eyebrow","label":"Small heading"},{"type":"textarea","id":"title","label":"Heading","default":"Made for your home"},{"type":"text","id":"button","label":"Button label","default":"Shop blinds"},{"type":"url","id":"link","label":"Button link"}]}],"presets":[{"name":"Blinds hero"}]}
{% endschema %}
