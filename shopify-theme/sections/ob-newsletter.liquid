<section class="border-t border-border bg-foreground py-14 md:py-20"><div class="mx-auto max-w-7xl px-5 md:px-8"><div class="flex flex-col items-center text-center gap-6 md:gap-8"><span class="inline-flex items-center rounded-full border border-white/10 bg-white/8 px-4 py-1.5 text-[11px] font-semibold uppercase tracking-[0.12em] text-white/70">Exclusive Offer</span>{% form 'customer', class: 'flex flex-col items-center text-center gap-6 md:gap-8 w-full', id: 'ob-newsletter' %}{% if form.posted_successfully? %}<div class="space-y-3"><h2 class="font-display text-[28px] font-semibold leading-tight text-white md:text-[38px]">You&#x27;re all set!</h2><p class="mx-auto max-w-md text-[15px] leading-relaxed text-white/80">Here&#x27;s your 15% discount code. Enter it in your cart, alongside any other code.</p><div class="flex flex-col items-center justify-center gap-3 pt-2 sm:flex-row"><span class="rounded-[12px] border border-dashed border-white/40 bg-white/8 px-6 py-3 font-jost text-[18px] font-semibold tracking-[0.12em] text-white">SUBSCRIBE15</span><button type="button" onclick="var b=this;navigator.clipboard&&navigator.clipboard.writeText('SUBSCRIBE15').then(function(){b.textContent='Copied'}).catch(function(){})" class="h-12 rounded-[12px] bg-primary px-6 text-[13px] font-semibold uppercase tracking-[0.06em] text-white transition-all hover:bg-primary-dark">Copy Code</button></div></div>{% else %}<div class="space-y-3 text-center"><h2 class="font-display text-[28px] font-semibold leading-tight text-white md:text-[38px]">Sign Up and Get <!-- -->15<!-- -->% Off</h2><p class="mx-auto max-w-lg text-center text-[15px] leading-relaxed text-white/80">Subscribe and get a <span class="font-semibold text-white">15<!-- -->% discount code</span> you can use on top of other offers. No spam — just great blinds at better prices.</p></div><div class="flex w-full max-w-md flex-col gap-3 sm:flex-row"><input type="hidden" name="contact[tags]" value="newsletter"><input type="email" name="contact[email]" required="" placeholder="Enter your email address" class="h-12 flex-1 rounded-[12px] border border-white/10 bg-white/8 px-4 text-[14px] text-white placeholder:text-white/55 outline-none focus:border-white/30 focus:bg-white/12 transition-colors" value=""/><button type="submit" onclick="var f=this.form;if(f.checkValidity()){var b=this;setTimeout(function(){b.disabled=true;b.textContent='Sending…'},0)}" class="h-12 shrink-0 rounded-[12px] bg-primary px-6 text-[13px] font-semibold uppercase tracking-[0.06em] text-white transition-all hover:bg-primary-dark disabled:opacity-60">Get My 15% Off</button></div>{% if form.errors %}<p role="alert" class="text-[13px] text-red-300">{% for field in form.errors %}{{ form.errors.messages[field] }} {% endfor %}</p>{% endif %}<p class="text-[12px] text-white/60">By subscribing you agree to receive marketing emails. Unsubscribe anytime.</p>{% endif %}{% endform %}<script>(function(){var f=document.getElementById('ob-newsletter');if(!f||!(/[?&]customer_posted=true/.test(location.search)||f.querySelector('[role=alert]')))return;var go=function(){f.scrollIntoView({block:'center'})};go();addEventListener('load',function(){setTimeout(go,50)})})()</script></div></div></section>
