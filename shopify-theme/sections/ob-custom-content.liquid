<section class="ob-section" style="background:{{ section.settings.background }};color:{{ section.settings.text_color }};padding-top:{{ section.settings.padding }}px;padding-bottom:{{ section.settings.padding }}px">
  <div class="ob-wrap" style="text-align:{{ section.settings.alignment }}">
    {% if section.settings.image %}{{ section.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', style: 'max-width:100%;height:auto;margin:0 auto 24px' }}{% endif %}
    {% if section.settings.heading != blank %}<h2 class="ob-title">{{ section.settings.heading | escape }}</h2>{% endif %}
    <div class="ob-copy">{{ section.settings.text }}</div>
    {% if section.settings.link != blank and section.settings.link_label != blank %}<a class="ob-button" href="{{ section.settings.link }}">{{ section.settings.link_label | escape }}</a>{% endif %}
  </div>
</section>
{% schema %}
{"name":"Custom image and text","settings":[
{"type":"text","id":"heading","label":"Heading","default":"Made for your home"},
{"type":"richtext","id":"text","label":"Text"},
{"type":"image_picker","id":"image","label":"Image"},
{"type":"text","id":"link_label","label":"Button label"},
{"type":"url","id":"link","label":"Button link"},
{"type":"select","id":"alignment","label":"Alignment","default":"center","options":[{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}]},
{"type":"color","id":"background","label":"Background","default":"#ffffff"},
{"type":"color","id":"text_color","label":"Text color","default":"#111111"},
{"type":"range","id":"padding","label":"Vertical spacing","min":0,"max":120,"step":4,"unit":"px","default":64}
],"presets":[{"name":"Custom image and text"}]}
{% endschema %}
