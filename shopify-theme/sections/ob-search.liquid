{% paginate search.results by 24 %}
<div data-ob-island="search-design" data-ob-client="true"><script type="application/json" data-ob-props>{"query":{{ search.terms | default: '' | json }},"products":[{% assign emitted = false %}{% for result in search.results %}{% if result.object_type == 'product' %}{% if emitted %},{% endif %}{% render 'ob-card-json', card_product: result %}{% assign emitted = true %}{% endif %}{% endfor %}],"currentSort":{{ search.sort_by | default: 'relevance' | json }},"pagination":{"page":{{ paginate.current_page }},"limit":24,"total":{{ search.results_count }},"totalPages":{{ paginate.pages }},"hasNextPage":{% if paginate.next %}true{% else %}false{% endif %},"hasPreviousPage":{% if paginate.previous %}true{% else %}false{% endif %}}}</script><section class="ob-section"><div class="ob-wrap"><h1 class="ob-title">Search</h1><form action="{{ routes.search_url }}"><input type="hidden" name="type" value="product"><input name="q" value="{{ search.terms | escape }}" aria-label="Search products" class="ob-input"><button class="ob-button">Search</button></form></div></section></div>
{% endpaginate %}
{% schema %}{"name":"Online Blinds search","settings":[]}{% endschema %}
