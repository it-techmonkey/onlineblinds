<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ page_title | escape }}{% unless page_title contains shop.name %} — {{ shop.name | escape }}{% endunless %}</title>
    {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
    <link rel="canonical" href="{{ canonical_url }}">
    <script>window.dataLayer=window.dataLayer||[];(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
})(window,document,'script','dataLayer','GTM-5KVNBLSF');</script>
    {{ content_for_header }}
    {{ 'ob-fonts.css' | asset_url | stylesheet_tag }}
    {{ 'ob-storefront.css' | asset_url | stylesheet_tag }}
    {{ 'ob-theme.css' | asset_url | stylesheet_tag }}
    {% render 'ob-theme-settings' %}
    {% render 'ob-runtime' %}
    <script>window.OnlineBlinds.catalogData={{ 'ob-catalog-data.json' | asset_url | json }};window.OnlineBlinds.reviewsData={{ 'ob-reviews-data.json' | asset_url | json }};</script>
    <script src="{{ 'ob-storefront.js' | asset_url }}" defer></script>
  </head>
  <body class="antialiased font-jost">
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-5KVNBLSF" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <a class="ob-skip" href="#MainContent">Skip to content</a>
    {% section 'ob-announcement' %}
    {% section 'ob-header' %}
    <main id="MainContent" tabindex="-1">{{ content_for_layout }}</main>
    {% section 'ob-footer' %}
    <div data-ob-island="polish" data-ob-client="true"></div>
    <div data-ob-island="signup-popup" data-ob-client="true"><script type="application/json" data-ob-props>{"shopifyForm":true}</script></div>
  </body>
</html>
