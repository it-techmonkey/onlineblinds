<div data-ob-island="faq" data-ob-client="true"><script type="application/json" data-ob-props>{"heading":{{ section.settings.heading | json }},"subtitle":{{ section.settings.subtitle | json }},"items":[{% for block in section.blocks %}{"id":{{ forloop.index }},"question":{{ block.settings.question | json }},"answer":{{ block.settings.answer | json }}}{% unless forloop.last %},{% endunless %}{% endfor %}]}</script></div>
{% schema %}
{"name":"Blinds FAQ","settings":[{"type":"text","id":"heading","label":"Heading","default":"Common Questions"},{"type":"text","id":"subtitle","label":"Subtitle","default":"Everything you need to know before ordering"},{"type":"paragraph","content":"The original questions are used until you add custom question blocks."}],"max_blocks":20,"blocks":[{"type":"question","name":"Question","settings":[{"type":"text","id":"question","label":"Question","default":"Your question"},{"type":"textarea","id":"answer","label":"Answer","default":"Your answer"}]}],"presets":[{"name":"Blinds FAQ"}]}
{% endschema %}
